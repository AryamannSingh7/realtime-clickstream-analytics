<?xml version="1.0"?>
<!--
  Bounds ClickHouse's self-instrumentation, which otherwise dwarfs the data it stores.
  Measured on this stack after ~40 minutes at 200 eps: analytics.events was 20.5 MiB
  while the system.* log tables totalled ~162 MiB (text_log alone: 2M rows). Left alone,
  the clickhouse-data volume grows into the gigabytes with almost none of it being events.

  The high-frequency logs are removed outright. query_log and error_log are kept — they
  earn their keep when debugging the OLAP endpoints — but bounded by a TTL so they can't
  grow without limit.

  Mounted as a single file into config.d (never as a directory: the official image ships
  its own docker_related_config.xml in there, and a directory mount would hide it).
-->
<clickhouse>
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <part_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <session_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <blob_storage_log remove="1"/>
    <backup_log remove="1"/>
    <zookeeper_log remove="1"/>

    <query_log>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </query_log>
    <error_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </error_log>
</clickhouse>
