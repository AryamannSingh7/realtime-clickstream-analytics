<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.clickstream</groupId>
    <artifactId>clickstream-analytics-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Real-Time Clickstream Analytics :: Parent</name>
    <description>Aggregator / parent POM for the real-time clickstream analytics pipeline.</description>

    <modules>
        <module>services/common</module>
        <module>services/event-generator</module>
        <module>services/stream-processor</module>
        <module>services/analytics-api</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Dependency versions -->
        <spring-boot.version>3.4.1</spring-boot.version>
        <avro.version>1.12.0</avro.version>
        <confluent.version>7.8.0</confluent.version>
        <kafka.version>3.8.1</kafka.version>
        <clickhouse-jdbc.version>0.7.2</clickhouse-jdbc.version>

        <!-- Integration-test tooling (activated by the `integration-tests` profile). -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM (imported, not inherited, so non-Spring modules stay lean) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers BOM: aligns testcontainers, junit-jupiter, kafka, clickhouse. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>${avro.version}</version>
            </dependency>
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-avro-serializer</artifactId>
                <version>${confluent.version}</version>
            </dependency>
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-streams-avro-serde</artifactId>
                <version>${confluent.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Retain method/constructor parameter names so Spring MVC (@RequestParam)
                     and other reflection-based binding work without explicit names. The
                     Spring Boot starter-parent sets this for you; we import the BOM instead,
                     so enable it here. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.avro</groupId>
                    <artifactId>avro-maven-plugin</artifactId>
                    <version>${avro.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Integration tests (Testcontainers) are opt-in: they need a Docker engine, so the
             default `mvn verify` stays fast and unit-only. Activate with `-Pintegration-tests`
             (a dedicated CI job does this). Failsafe runs the `*IT.java` classes at `verify`;
             Surefire keeps running the `*Test.java` unit classes on every build.
             Defined here in the parent so every module inherits it. -->
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${maven-failsafe-plugin.version}</version>
                        <configuration>
                            <!-- Test against the exploded classes, not the module's own artifact.
                                 spring-boot:repackage (package phase) rewrites <module>.jar into a
                                 fat jar with classes under BOOT-INF/classes/; if Failsafe put that
                                 on the test classpath the app's own classes would be invisible
                                 (NoClassDefFoundError). -->
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <!-- Confluent public Maven repo (free) for Avro serializers / Schema Registry client -->
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </pluginRepository>
    </pluginRepositories>
</project>
